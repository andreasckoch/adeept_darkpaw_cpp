{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host tools",
      "description": "Configure portable host-side tools and tests without Raspberry Pi pigpio targets.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-host",
      "cacheVariables": {
        "SPIDER_BUILD_HOST_TOOLS": "ON",
        "SPIDER_BUILD_PI_TARGETS": "OFF",
        "SPIDER_BUILD_DESKTOP_APP": "OFF",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "host-desktop-viewer",
      "displayName": "Host desktop viewer",
      "description": "Configure portable host tools, telemetry tests, and the browser-based desktop viewer helper target.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-host-viewer",
      "cacheVariables": {
        "SPIDER_BUILD_HOST_TOOLS": "ON",
        "SPIDER_BUILD_PI_TARGETS": "OFF",
        "SPIDER_BUILD_DESKTOP_APP": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "pi",
      "displayName": "Raspberry Pi",
      "description": "Configure Raspberry Pi hardware targets plus portable tools.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-pi",
      "cacheVariables": {
        "SPIDER_BUILD_HOST_TOOLS": "ON",
        "SPIDER_BUILD_PI_TARGETS": "ON",
        "SPIDER_BUILD_DESKTOP_APP": "OFF",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "host",
      "displayName": "Build host tools",
      "configurePreset": "host"
    },
    {
      "name": "host-teleop-keyboard",
      "displayName": "Build host keyboard teleop client",
      "configurePreset": "host",
      "targets": [
        "spider_teleop_keyboard"
      ]
    },
    {
      "name": "host-tests",
      "displayName": "Build host tests",
      "configurePreset": "host",
      "targets": [
        "test_servo_math",
        "test_motion_command",
        "test_gait_controller",
        "test_gait_authoring",
        "test_gait_examples",
        "test_semantic_authoring",
        "test_teleop",
        "test_sensor_telemetry"
      ]
    },
    {
      "name": "host-desktop-viewer",
      "displayName": "Build desktop viewer helper target",
      "configurePreset": "host-desktop-viewer",
      "targets": [
        "spider_viewer",
        "spider_sensor_telemetry_mock"
      ]
    },
    {
      "name": "pi",
      "displayName": "Build Raspberry Pi targets",
      "configurePreset": "pi"
    },
    {
      "name": "pi-sensor-streamer",
      "displayName": "Build Raspberry Pi sensor streamer",
      "configurePreset": "pi",
      "targets": [
        "spider_sensor_streamer"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "displayName": "Run host tests",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "pi",
      "displayName": "Run Raspberry Pi tests",
      "configurePreset": "pi",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
